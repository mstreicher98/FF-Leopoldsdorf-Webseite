# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Adresse der Webseite, ohne https:// (DNS muss auf den Server zeigen).
# Noch keine Domain? Zum Testen geht <IP-mit-Bindestrichen>.sslip.io,
# z. B. 203-0-113-10.sslip.io – Caddy holt auch dafür ein Zertifikat.
DOMAIN=ff-leopoldsdorf.net

# Fertiges Image, das GitHub Actions bei jedem Push auf main baut
APP_IMAGE=ghcr.io/mstreicher98/ff-leopoldsdorf-webseite:latest

# Erster Admin-Zugang – wird nur beim allerersten Start angelegt.
# Ohne Passwort wird eines erzeugt und einmalig im Log angezeigt (docker compose logs app).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
